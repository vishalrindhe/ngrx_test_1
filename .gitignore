import { Component, EventEmitter, Input, Output, signal } from '@angular/core';
import { RouterModule, Routes } from '@angular/router';
import { createRoutingFactory, Spectator } from '@ngneat/spectator/jest';
import { NgxPermissionsModule } from 'ngx-permissions';

import {
  CacheService,
  OvCoreModule,
  PatientNavigationService,
  PatientType,
  provideEnvironment,
} from '@ov-workspace-ui/ov-core';
import { provideEnv } from '@ov-workspace-ui/ov-components';

import { PracticeIkcCkdPatientsContainerComponent } from './practice-ikc-ckd-patients-container.component';
import { IkcCkdPatientsTableComponent } from '../ikc-ckd-patients-table/ikc-ckd-patients-table.component';
import { IkcCkdPatientStore } from '../ikc-ckd-patient-store/ikc-ckd-patient-store';

import { IkcCkdPatientListItem } from '../../../models/ikc-ckd-patient-info';

const envSample = {
  mirroring: false,
};

const npi = '12345';

@Component({
  selector: 'dps-ikc-ckd-patients-table',
  template: '<span></span>',
  standalone: true,
})
class IkcCkdPatientsTableStubComponent {
  @Input() allIkcCkdPatientListItems: IkcCkdPatientListItem[] = [];
  @Input() disabledPatientNavigation = false;
  @Input() tableHeight = '40rem';
  @Input() isDownloading = false;

  @Output() rowSelect = new EventEmitter<unknown>();
}

@Component({
  selector: 'dps-page-stub',
  template: '<span></span>',
  standalone: true,
})
class PageStubComponent {}

const routeSample: Routes = [
  {
    path: 'patients/ikc-ckd-patients',
    component: PageStubComponent,
    children: [
      {
        path: 'npi/:npi/physicianPartySeqNo/:physicianPartySeqNo',
        component: PageStubComponent,
      },
    ],
  },
];

describe('PracticeIkcCkdPatientsContainerComponent - Store based', () => {
  let spectator: Spectator<PracticeIkcCkdPatientsContainerComponent>;
  let component: PracticeIkcCkdPatientsContainerComponent;

  let store: {
    loadPatients: jest.Mock;
    ikcPrograms: ReturnType<typeof signal>;
    allIkcCkdPatientListItems: ReturnType<typeof signal>;
    patientsLoaded: ReturnType<typeof signal>;
    error: ReturnType<typeof signal>;
  };

  let cacheService: {
    getFromSession: jest.Mock;
  };

  let patientNavigationService: {
    openPatient: jest.Mock;
  };

  const createStoreMock = () => ({
    loadPatients: jest.fn(),

    ikcPrograms: signal<string[]>([]),

    allIkcCkdPatientListItems:
      signal<IkcCkdPatientListItem[]>([]),

    patientsLoaded: signal(false),

    error: signal<unknown>(null),
  });

  const createComponent = createRoutingFactory({
    component: PracticeIkcCkdPatientsContainerComponent,

    imports: [
      OvCoreModule,
      RouterModule.forRoot([]),
    ],

    overrideComponents: [
      [
        PracticeIkcCkdPatientsContainerComponent,
        {
          remove: {
            imports: [IkcCkdPatientsTableComponent],
          },

          add: {
            imports: [IkcCkdPatientsTableStubComponent],
          },
        },
      ],
    ],

    providers: [
      {
        provide: IkcCkdPatientStore,

        useFactory: () => {
          store = createStoreMock();

          return store;
        },
      },

      {
        provide: CacheService,

        useValue: {
          getFromSession: jest.fn(),
        },
      },

      {
        provide: PatientNavigationService,

        useValue: {
          openPatient: jest.fn(),
        },
      },

      provideEnv(envSample),

      provideEnvironment(envSample),
    ],

    params: {
      npi,
    },

    routes: routeSample,

    shallow: true,

    detectChanges: false,
  });

  beforeEach(() => {
    jest.clearAllMocks();

    spectator = createComponent();

    component = spectator.component;

    cacheService =
      spectator.inject(CacheService) as unknown as {
        getFromSession: jest.Mock;
      };

    patientNavigationService =
      spectator.inject(
        PatientNavigationService,
      ) as unknown as {
        openPatient: jest.Mock;
      };
  });

  afterEach(() => {
    jest.restoreAllMocks();
  });

  // ---------------------------------------------------------
  // Component initialization
  // ---------------------------------------------------------

  describe('initialization', () => {
    it('should create the component', () => {
      expect(component).toBeTruthy();
    });

    it('should load patients through the store when route params are present', async () => {
      spectator.detectChanges();

      await spectator.fixture.whenStable();

      expect(store.loadPatients).toHaveBeenCalledTimes(1);

      expect(store.loadPatients).toHaveBeenCalledWith({
        caseType: 'ckd',
        version: 'v3',
      });
    });

    it('should not fail when route params are empty', async () => {
      const noParamSpectator = createRoutingFactory({
        component:
          PracticeIkcCkdPatientsContainerComponent,

        imports: [
          OvCoreModule,
          RouterModule.forRoot([]),
        ],

        overrideComponents: [
          [
            PracticeIkcCkdPatientsContainerComponent,
            {
              remove: {
                imports: [
                  IkcCkdPatientsTableComponent,
                ],
              },

              add: {
                imports: [
                  IkcCkdPatientsTableStubComponent,
                ],
              },
            },
          ],
        ],

        providers: [
          {
            provide: IkcCkdPatientStore,

            useFactory: () => {
              store = createStoreMock();

              return store;
            },
          },

          {
            provide: CacheService,

            useValue: {
              getFromSession: jest.fn(),
            },
          },

          {
            provide: PatientNavigationService,

            useValue: {
              openPatient: jest.fn(),
            },
          },

          provideEnv(envSample),

          provideEnvironment(envSample),
        ],

        params: {},

        routes: routeSample,

        shallow: true,

        detectChanges: false,
      });

      const noParam = noParamSpectator();

      noParam.detectChanges();

      await noParam.fixture.whenStable();

      expect(noParam.component).toBeTruthy();

      expect(store.loadPatients).not.toHaveBeenCalled();
    });
  });

  // ---------------------------------------------------------
  // Store state
  // ---------------------------------------------------------

  describe('store state', () => {
    it('should expose the patient list supplied by the store', async () => {
      const items = Array.from(
        { length: 17 },

        (_, index) =>
          ({
            cernerMrn: `${1000 + index}`,
            cernerPersonId: `${2000 + index}`,
            firstName: `First${index}`,
            lastName: `Last${index}`,
          }) as IkcCkdPatientListItem,
      );

      store.allIkcCkdPatientListItems.set(items);

      store.patientsLoaded.set(true);

      spectator.detectChanges();

      await spectator.fixture.whenStable();

      expect(
        component.ckdPatientsState()
          .allIkcCkdPatientListItems,
      ).toEqual(items);

      expect(
        component.ckdPatientsState()
          .allIkcCkdPatientListItems,
      ).toHaveLength(17);

      expect(
        component.ckdPatientsState().patientsLoaded,
      ).toBe(true);
    });

    it('should reflect the store loading state', () => {
      store.patientsLoaded.set(false);

      spectator.detectChanges();

      expect(
        component.ckdPatientsState().patientsLoaded,
      ).toBe(false);

      store.patientsLoaded.set(true);

      spectator.detectChanges();

      expect(
        component.ckdPatientsState().patientsLoaded,
      ).toBe(true);
    });

    it('should reflect the store error state', async () => {
      const error = {
        status: 403,

        error: {
          message:
            'User is not allowed to view resource: Patient list is generated only for beta users.',
        },
      };

      store.error.set(error);

      spectator.detectChanges();

      await spectator.fixture.whenStable();

      expect(
        component.ckdPatientsState().showPatientState,
      ).toBe(true);
    });

    it('should handle an empty patient list', async () => {
      store.allIkcCkdPatientListItems.set([]);

      store.patientsLoaded.set(true);

      spectator.detectChanges();

      await spectator.fixture.whenStable();

      expect(
        component.ckdPatientsState()
          .allIkcCkdPatientListItems,
      ).toEqual([]);

      expect(
        component.ckdPatientsState()
          .allIkcCkdPatientListItems,
      ).toHaveLength(0);

      expect(
        component.ckdPatientsState().patientsLoaded,
      ).toBe(true);
    });

    it('should expose IKC programs from the store', async () => {
      const programs = [
        'CKCC1',
        'CKCC2',
      ];

      store.ikcPrograms.set(programs);

      spectator.detectChanges();

      await spectator.fixture.whenStable();

      expect(
        component.ckdPatientsState().ikcPrograms,
      ).toEqual(programs);
    });
  });

  // ---------------------------------------------------------
  // Row selection
  // ---------------------------------------------------------

  describe('rowSelect', () => {
    it('should open the selected patient using PatientNavigationService', async () => {
      const event = {
        data: {
          cernerMrn: '12345',
          cernerPersonId: '54321',
          lastName: 'Lastname',
          firstName: 'Firstname',
        },
      };

      store.allIkcCkdPatientListItems.set([
        event.data as unknown as IkcCkdPatientListItem,
      ]);

      store.patientsLoaded.set(true);

      spectator.detectChanges();

      await spectator.fixture.whenStable();

      component.onRowSelect(event);

      expect(
        patientNavigationService.openPatient,
      ).toHaveBeenCalledWith({
        activeTab: false,

        cernerMrn:
          event.data.cernerMrn,

        cernerPid:
          event.data.cernerPersonId,

        cheDocumentId: 'none',

        path:
          `patients/npi/${npi}/ckd/` +
          `${event.data.cernerPersonId}/mrn/` +
          `${event.data.cernerMrn}/patient-details`,

        patientName:
          `${event.data.lastName}, ` +
          `${event.data.firstName}`,

        patientType:
          PatientType['IKC-CKD'],
      });
    });

    it('should not navigate when row event is undefined', () => {
      component.onRowSelect(undefined as never);

      expect(
        patientNavigationService.openPatient,
      ).not.toHaveBeenCalled();
    });
  });

  // ---------------------------------------------------------
  // Roster params
  // ---------------------------------------------------------

  describe('setRosterParams', () => {
    it('should set roster params when provider NPI matches', () => {
      cacheService.getFromSession.mockReturnValue({
        npi,

        username: 'testUser',
      });

      component.setRosterParams(npi);

      expect(
        component.rosterParams(),
      ).toEqual({
        npi,

        activeDirectoryId: 'testUser',
      });
    });

    it('should set empty activeDirectoryId when username is null', () => {
      cacheService.getFromSession.mockReturnValue({
        npi,

        username: null,
      });

      component.setRosterParams(npi);

      expect(
        component.rosterParams(),
      ).toEqual({
        npi,

        activeDirectoryId: '',
      });
    });

    it('should remain undefined when provider NPI does not match', () => {
      cacheService.getFromSession.mockReturnValue({
        npi: '999999',

        username: 'testUser',
      });

      component.setRosterParams(npi);

      expect(
        component.rosterParams(),
      ).toBeUndefined();
    });

    it('should remain undefined when provider is null', () => {
      cacheService.getFromSession.mockReturnValue(null);

      component.setRosterParams(npi);

      expect(
        component.rosterParams(),
      ).toBeUndefined();
    });

    it('should remain undefined when provider is undefined', () => {
      cacheService.getFromSession.mockReturnValue(undefined);

      component.setRosterParams(npi);

      expect(
        component.rosterParams(),
      ).toBeUndefined();
    });
  });

  // ---------------------------------------------------------
  // Window resize
  // ---------------------------------------------------------

  describe('resize', () => {
    it('should recalculate table height when window is resized', () => {
      Object.defineProperty(window, 'innerHeight', {
        configurable: true,

        value: 300,
      });

      const resizeSpy = jest.spyOn(
        component,
        'onResize',
      );

      spectator.detectChanges();

      window.dispatchEvent(
        new Event('resize'),
      );

      expect(resizeSpy).toHaveBeenCalled();

      expect(
        component.windowInnerHeight(),
      ).toBe(300);

      expect(
        component.tableHeight(),
      ).toBe('80px');
    });
  });
});
‐--------------------
import { Component, input, output } from '@angular/core';
import { HttpErrorResponse } from '@angular/common/http';
import { ActivatedRoute, RouterModule } from '@angular/router';
import {
  createRoutingFactory,
  Spectator,
} from '@ngneat/spectator/jest';
import { of } from 'rxjs';

import {
  AuditAction,
  AuditModuleName,
  AuditService,
  AuthenticationService,
  GenericMessageErrorService,
  OvCoreModule,
  PatientNavigationService,
  PatientType,
  provideEnvironment,
} from '@ov-workspace-ui/ov-core';

import { IkcCkdPatientsComponent } from './ikc-ckd-patients.component';
import { IkcCkdPatientsTableComponent } from '../ikc-ckd-patients-table/ikc-ckd-patients-table.component';
import { IkcCkdPatientStore } from '../../services/ikc-ckd-patient-store';
import { RosterAuthParams } from '../../../../../shared/types/roster-auth-params';
import { IKC_CKD_PATIENT_TAB_NO_FILTER_OFFSET } from '../../../../types';

import {
  getMockIkcCkdPatientListItems,
} from '../mocks/ikc-ckd-patients-table.mock.data';

/**
 * Stub only the child component that the component under test uses.
 */
@Component({
  selector: 'dps-ikc-ckd-patients-table',
  standalone: true,
  template: '',
})
class IkcCkdPatientsTableStubComponent {
  ikcPrograms = input<string[]>([]);
  allIkcCkdPatientListItems = input<any[]>([]);
  patientsLoaded = input<boolean>(false);
  tableHeight = input<string>('40rem');
  rosterParams = input<RosterAuthParams | undefined>(undefined);

  rowSelect = output<any>();
}

describe('IkcCkdPatientsComponent', () => {
  let spectator: Spectator<IkcCkdPatientsComponent>;
  let component: IkcCkdPatientsComponent;

  let store: {
    ikcPrograms: jest.Mock;
    allIkcCkdPatientListItems: jest.Mock;
    patientsLoaded: jest.Mock;
    error: jest.Mock;
    loadPatients: jest.Mock;
  };

  let authenticationService: {
    getParsedToken: jest.Mock;
  };

  let patientNavigationService: {
    openPatient: jest.Mock;
  };

  let auditService: {
    auditUser: jest.Mock;
  };

  let genericMessageErrorService: {
    getErrorMessage: jest.Mock;
  };

  const storeStub = {
    ikcPrograms: jest.fn().mockReturnValue(undefined),
    allIkcCkdPatientListItems: jest.fn().mockReturnValue([]),
    patientsLoaded: jest.fn().mockReturnValue(false),
    error: jest.fn().mockReturnValue(undefined),
    loadPatients: jest.fn(),
  };

  const authenticationServiceStub = {
    getParsedToken: jest.fn().mockReturnValue({
      NPI: '123456',
      activeDirectoryId: 'user123',
    }),
  };

  const patientNavigationServiceStub = {
    openPatient: jest.fn(),
  };

  const auditServiceStub = {
    auditUser: jest.fn(),
  };

  const genericMessageErrorServiceStub = {
    getErrorMessage: jest.fn().mockReturnValue({
      message: 'Oops, your action cannot be completed at this time.',
    }),
  };

  const envSample = {
    mirroring: false,
    SHOW_IKC_CKD_GUIDE: true,
  };

  const createComponent = createRoutingFactory({
    component: IkcCkdPatientsComponent,

    /**
     * Important:
     * Do not automatically run ngOnInit before our spies are ready.
     */
    detectChanges: false,

    data: {
      caseType: 'ckd',
    },

    imports: [
      OvCoreModule,
      RouterModule.forRoot([]),
    ],

    overrideComponents: [
      [
        IkcCkdPatientsComponent,
        {
          remove: {
            imports: [IkcCkdPatientsTableComponent],
          },
          add: {
            imports: [IkcCkdPatientsTableStubComponent],
          },
        },
      ],
    ],

    providers: [
      {
        provide: IkcCkdPatientStore,
        useValue: storeStub,
      },
      {
        provide: AuthenticationService,
        useValue: authenticationServiceStub,
      },
      {
        provide: PatientNavigationService,
        useValue: patientNavigationServiceStub,
      },
      {
        provide: AuditService,
        useValue: auditServiceStub,
      },
      {
        provide: GenericMessageErrorService,
        useValue: genericMessageErrorServiceStub,
      },
      provideEnvironment(envSample),
    ],
  });

  beforeEach(() => {
    jest.clearAllMocks();

    spectator = createComponent();
    component = spectator.component;

    store = spectator.inject(IkcCkdPatientStore) as unknown as typeof store;
    authenticationService =
      spectator.inject(AuthenticationService) as unknown as typeof authenticationService;
    patientNavigationService =
      spectator.inject(
        PatientNavigationService
      ) as unknown as typeof patientNavigationService;
    auditService =
      spectator.inject(AuditService) as unknown as typeof auditService;
    genericMessageErrorService =
      spectator.inject(
        GenericMessageErrorService
      ) as unknown as typeof genericMessageErrorService;

    /**
     * Default successful store state.
     */
    store.ikcPrograms.mockReturnValue(['CCKC']);

    store.allIkcCkdPatientListItems.mockReturnValue(
      getMockIkcCkdPatientListItems()
    );

    store.patientsLoaded.mockReturnValue(true);

    store.error.mockReturnValue(undefined);

    authenticationService.getParsedToken.mockReturnValue({
      NPI: '123456',
      activeDirectoryId: 'user123',
    });
  });

  // ---------------------------------------------------------------------------
  // CREATE
  // ---------------------------------------------------------------------------

  it('should create', () => {
    spectator.detectChanges();

    expect(component).toBeTruthy();
  });

  // ---------------------------------------------------------------------------
  // ngOnInit
  // ---------------------------------------------------------------------------

  describe('ngOnInit', () => {
    it('should set rosterParams from parsed token', async () => {
      authenticationService.getParsedToken.mockReturnValue({
        NPI: '123456',
        activeDirectoryId: 'user123',
      });

      spectator.detectChanges();

      await spectator.fixture.whenStable();

      expect(component.rosterParams()).toEqual({
        npi: '123456',
        activeDirectoryId: 'user123',
      });
    });

    it('should set undefined roster params when getParsedToken returns null', async () => {
      authenticationService.getParsedToken.mockReturnValue(null);

      spectator.detectChanges();

      await spectator.fixture.whenStable();

      expect(component.rosterParams()).toEqual({
        npi: undefined,
        activeDirectoryId: undefined,
      });
    });

    it('should set undefined roster params when getParsedToken returns undefined', async () => {
      authenticationService.getParsedToken.mockReturnValue(undefined);

      spectator.detectChanges();

      await spectator.fixture.whenStable();

      expect(component.rosterParams()).toEqual({
        npi: undefined,
        activeDirectoryId: undefined,
      });
    });

    it('should handle token with missing NPI', async () => {
      authenticationService.getParsedToken.mockReturnValue({
        activeDirectoryId: 'user123',
      });

      spectator.detectChanges();

      await spectator.fixture.whenStable();

      expect(component.rosterParams()).toEqual({
        npi: undefined,
        activeDirectoryId: 'user123',
      });
    });

    it('should handle token with missing activeDirectoryId', async () => {
      authenticationService.getParsedToken.mockReturnValue({
        NPI: '123456',
      });

      spectator.detectChanges();

      await spectator.fixture.whenStable();

      expect(component.rosterParams()).toEqual({
        npi: '123456',
        activeDirectoryId: undefined,
      });
    });

    it('should call store.loadPatients with route caseType and v3', async () => {
      spectator.detectChanges();

      await spectator.fixture.whenStable();

      expect(store.loadPatients).toHaveBeenCalledTimes(1);

      expect(store.loadPatients).toHaveBeenCalledWith({
        caseType: 'ckd',
        version: 'v3',
      });
    });

    it('should call auditUser on initialization', async () => {
      spectator.detectChanges();

      await spectator.fixture.whenStable();

      expect(auditService.auditUser).toHaveBeenCalledTimes(1);

      expect(auditService.auditUser).toHaveBeenCalledWith({
        moduleName: AuditModuleName.IkcCkdPatientsList,
        action: AuditAction.view,
        entityType: AuditModuleName.IkcCkdPatientsList,
        eventDetails: 'View IKC CKD Patients List',
      });
    });
  });

  // ---------------------------------------------------------------------------
  // STORE INTERACTION
  // ---------------------------------------------------------------------------

  describe('store interaction', () => {
    it('should read IKC programs from store', () => {
      const programs = ['CCKC'];

      store.ikcPrograms.mockReturnValue(programs);

      spectator.detectChanges();

      expect(component.ikcPrograms()).toEqual(programs);
    });

    it('should read patient list items from store', () => {
      const patients = getMockIkcCkdPatientListItems();

      store.allIkcCkdPatientListItems.mockReturnValue(patients);

      spectator.detectChanges();

      expect(component.store.allIkcCkdPatientListItems()).toEqual(
        patients
      );
    });

    it('should read patientsLoaded from store', () => {
      store.patientsLoaded.mockReturnValue(true);

      spectator.detectChanges();

      expect(component.store.patientsLoaded()).toBe(true);
    });

    it('should expose store patient data to the template', () => {
      const patients = getMockIkcCkdPatientListItems();

      store.allIkcCkdPatientListItems.mockReturnValue(patients);
      store.patientsLoaded.mockReturnValue(true);

      spectator.detectChanges();

      const table =
        spectator.query(IkcCkdPatientsTableStubComponent);

      expect(table).toBeTruthy();
    });
  });

  // ---------------------------------------------------------------------------
  // ERROR STATE
  // ---------------------------------------------------------------------------

  describe('error state', () => {
    const error = new HttpErrorResponse({
      status: 500,
      statusText: 'Internal Server Error',
    });

    it('should not show alert when store has no error', () => {
      store.error.mockReturnValue(undefined);

      spectator.detectChanges();

      expect(
        component.ckdPatientsState().showIkcCkdPatientsAlert
      ).toBe(false);
    });

    it('should show alert when store contains an error', () => {
      store.error.mockReturnValue(error);

      genericMessageErrorService.getErrorMessage.mockReturnValue({
        message: 'Oops, your action cannot be completed at this time.',
      });

      spectator.detectChanges();

      expect(
        component.ckdPatientsState().showIkcCkdPatientsAlert
      ).toBe(true);
    });

    it('should get the error message from GenericMessageErrorService', () => {
      store.error.mockReturnValue(error);

      spectator.detectChanges();

      expect(
        genericMessageErrorService.getErrorMessage
      ).toHaveBeenCalledTimes(1);

      expect(
        genericMessageErrorService.getErrorMessage
      ).toHaveBeenCalledWith({
        error,
      });
    });

    it('should configure the alert as dismissible when store has an error', () => {
      store.error.mockReturnValue(error);

      genericMessageErrorService.getErrorMessage.mockReturnValue({
        message: 'Something went wrong',
      });

      spectator.detectChanges();

      expect(
        component.ckdPatientsState().patientsAlertConfig
      ).toEqual(
        expect.objectContaining({
          isOpen: true,
          type: 'error',
          title: 'Something went wrong',
          dismissible: true,
        })
      );
    });

    it('should use the default alert configuration when there is no error', () => {
      store.error.mockReturnValue(undefined);

      spectator.detectChanges();

      expect(
        component.ckdPatientsState().patientsAlertConfig
      ).toEqual({
        isOpen: false,
        type: 'error',
        title: '',
      });
    });
  });

  // ---------------------------------------------------------------------------
  // ROW SELECT
  // ---------------------------------------------------------------------------

  describe('onRowSelect', () => {
    const event = {
      data: {
        cernerMrn: '12345',
        cernerPersonId: '54321',
        lastName: 'Lastname',
        firstName: 'Firstname',
      },
    };

    it('should open the selected patient', () => {
      component.onRowSelect(event);

      expect(
        patientNavigationService.openPatient
      ).toHaveBeenCalledTimes(1);
    });

    it('should create the correct patient tab', () => {
      component.onRowSelect(event);

      expect(
        patientNavigationService.openPatient
      ).toHaveBeenCalledWith({
        activeTab: false,
        cernerMrn: '12345',
        cernerPid: '54321',
        path: 'patients/ckd/54321/mrn/12345/patient-details',
        patientName: 'Lastname, Firstname',
        patientType: PatientType['IKC-CKD'],
        cheDocumentId: 'none',
      });
    });

    it('should use cheDocumentId when it is available', () => {
      component.onRowSelect({
        data: {
          ...event.data,
          initiativesAndStatus: {
            cheDocumentId: 'CHE-123',
          },
        },
      });

      expect(
        patientNavigationService.openPatient
      ).toHaveBeenCalledWith(
        expect.objectContaining({
          cheDocumentId: 'CHE-123',
        })
      );
    });

    it('should use "none" when cheDocumentId is missing', () => {
      component.onRowSelect(event);

      expect(
        patientNavigationService.openPatient
      ).toHaveBeenCalledWith(
        expect.objectContaining({
          cheDocumentId: 'none',
        })
      );
    });
  });

  // ---------------------------------------------------------------------------
  // RESIZE
  // ---------------------------------------------------------------------------

  describe('onResize', () => {
    it('should update windowInnerHeight', () => {
      const originalHeight = window.innerHeight;

      Object.defineProperty(window, 'innerHeight', {
        configurable: true,
        value: 500,
      });

      component.onResize();

      expect(component.windowInnerHeight()).toBe(500);

      Object.defineProperty(window, 'innerHeight', {
        configurable: true,
        value: originalHeight,
      });
    });

    it('should update tableHeight based on windowInnerHeight', () => {
      component.windowInnerHeight.set(640);

      expect(component.tableHeight()).toBe(
        `${
          640 - IKC_CKD_PATIENT_TAB_NO_FILTER_OFFSET
        }px`
      );
    });

    it('should respond to window resize event', () => {
      const onResizeSpy = jest.spyOn(component, 'onResize');

      window.dispatchEvent(new Event('resize'));

      expect(onResizeSpy).toHaveBeenCalledTimes(1);
    });
  });
});